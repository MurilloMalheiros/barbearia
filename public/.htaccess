Options -Indexes
Options -MultiViews

# Bloqueia acesso a arquivos sensíveis
<FilesMatch "\.(env|json|sql|lock|log|md|gitignore)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(composer|package|package-lock)">
    Require all denied
</FilesMatch>

# Bloqueia execução de PHP na pasta de uploads
<Directory "uploads">
    php_flag engine off
    Options -Indexes
    <FilesMatch "\.php$">
        Require all denied
    </FilesMatch>
</Directory>

# Rewrite para Front Controller
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Não redireciona arquivos/diretórios existentes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Tudo para index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Headers de segurança
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header unset X-Powered-By

    # Cache para assets estáticos
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|svg|woff2|woff|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Compressão
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/xml
</IfModule>
